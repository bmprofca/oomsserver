# Everything else (Razorpay, Fast2SMS OTP, Backblaze B2, OneChatting, WhatsApp Web, OneSaaS
# upload, Google sign-in client ID, invitation link, GST rate) lives in the `platform_settings` table and
# is managed from ADMIN → Settings → Platform Settings. Do not add those keys here.

# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=60000
DB_QUERY_RETRIES=3
DB_QUERY_RETRY_DELAY_MS=1500

# Application
APP_NAME=OOMS
BASE_DOMAIN=https://server.ooms.in

# Firebase Cloud Messaging (FCM Push Notifications - Firebase Admin SDK)
# Path to the service account JSON file (relative to project root or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=ooms-e7b32-firebase-adminsdk-fbsvc-ff7d1d9126.json
# Alternatively, provide the raw JSON string for cloud/container environments:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Local development: do not run cron jobs against the shared database
DISABLE_BACKGROUND_JOBS=1

# Optional
# PORT=8877
# Encryption key for secrets stored in platform_settings and other credential tables.
# Set one in production; changing it makes previously stored secrets unreadable.
# APP_ENCRYPTION_KEY=
# Force media proxy URLs to the live API when BASE_DOMAIN is localhost
# MEDIA_PROXY_BASE_DOMAIN=https://server.ooms.in
