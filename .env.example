# Server
PORT=8877

# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=20000

# v3 → v5 branch migration (optional)
# Staging tables are imported into the same DB with prefix v3staging_
STAGING_TABLE_PREFIX=v3staging_
MIGRATE_SQL_DUMP=C:/Users/rinku/Downloads/u278432002_ooms_v3.sql
MIGRATE_OLD_APP_ID=APP2025
MIGRATE_OLD_BRANCH_ID=BRN2025
MIGRATE_NEW_BRANCH_ID=123456

# Application
APP_NAME=OOMS
BASE_DOMAIN=https://server.ooms.in
# Optional: force media proxy URLs to live API when BASE_DOMAIN is localhost
# MEDIA_PROXY_BASE_DOMAIN=https://server.ooms.in
GOOGLE_CLIENT_ID=
BASE_INVITATION_LINK=https://ooms-v4.vercel.com/invitation

# Backblaze B2 (client document storage)
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=OOMS-CRM
B2_ACCESS_KEY=
B2_SECRET_KEY=
B2_DOWNLOAD_AUTH_TTL_SECONDS=86400

# WhatsApp Web V2 (OOMS Web channel) — https://whatsappweb.onesaas.in
# QR-only login; no API key (auth is network/reverse-proxy side)
WHATSAPPWEB_BASE_URL=https://whatsappweb.onesaas.in
# Unused by V2; kept for older deployments
# WHATSAPPWEB_API_KEY=

# OneChatting (OOMS system WhatsApp channel)
ONECHATTING_BASE_URL=https://server.onechatting.com
ONECHATTING_SYSTEM_DEVELOPER_TOKEN=
ONECHATTING_PROJECT_DEVELOPER_TOKEN=
