# Platform integrations (Razorpay, Fast2SMS OTP, Backblaze B2, OneChatting, WhatsApp Web,
# OneSaaS upload, Google sign-in and Calendar OAuth client credentials, invitation link and GST rate) live in the
# `platform_settings` table and are managed from ADMIN → Settings → Platform Settings.
# Google Calendar company accounts are authorized per branch from Office Web.

# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=60000
DB_QUERY_RETRIES=3
DB_QUERY_RETRY_DELAY_MS=1500

# Application
APP_NAME=OOMS
BASE_DOMAIN=https://server.ooms.in
# Exact Office Web origin used after Google Calendar authorization (required in production).
OFFICE_WEB_ORIGIN=https://app.ooms.in

# Firebase Cloud Messaging (FCM Push Notifications - Firebase Admin SDK)
# Path to the service account JSON file (relative to project root or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=ooms-e7b32-firebase-adminsdk-fbsvc-ff7d1d9126.json
# Alternatively, provide the raw JSON string for cloud/container environments:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Local development: do not run cron jobs against the shared database
DISABLE_BACKGROUND_JOBS=1

# Optional
# PORT=8877
# Optional encryption keys for stored credentials. Google Calendar connection works
# without either key and uses the built-in fallback when both are unset.
# secretBox prefers APP_ENCRYPTION_KEY, then SMTP_ENCRYPTION_KEY, then the built-in
# fallback. Keep the selected key stable; changing it breaks decryption.
# APP_ENCRYPTION_KEY=
# SMTP_ENCRYPTION_KEY=
# Force media proxy URLs to the live API when BASE_DOMAIN is localhost
# MEDIA_PROXY_BASE_DOMAIN=https://server.ooms.in
